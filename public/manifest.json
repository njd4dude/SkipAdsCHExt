{
  "manifest_version": 3,
  "name": "Ad Skipper - Skip YouTube Ads Hands Free",
  "version": "1.0.3",
  "description": "Makes skipping ads a breeze.",
  "icons": {
    "16": "icons/16x16.png",
    "32": "icons/32x32.png",
    "48": "icons/48x48.png",
    "128": "icons/128x128.png"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "run_at": "document_start",
      "js": ["content.js"]
    },
    {
      "matches": ["<all_urls>"],
      "js": ["mellowtel.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "permissions": ["storage", "tabs", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"]
}
