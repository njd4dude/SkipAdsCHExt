{
  "manifest_version": 3,
  "name": "Youtube Ad Speedster",
  "version": "1.0.3",
  "description": "Speed up ads on youtube.",
  "icons": {
    "16": "icons/16x16.png",
    "32": "icons/32x32.png",
    "48": "icons/48x48.png",
    "128": "icons/128x128.png"
  },
  "action": {
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "run_at": "document_start",
      "js": ["content.js"]
    }
  ],
  "permissions": ["storage"]
}
