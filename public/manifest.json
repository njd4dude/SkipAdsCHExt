{
  "manifest_version": 3,
  "name": "Auto Skip YouTube Ads",
  "version": "1.0.26",
  "description": "Skip YouTube ads - perfect for those who prefer a hands-off approach.",
  "icons": {
    "16": "/icons/skipIcon16.png",
    "32": "/icons/skipIcon32.png",
    "48": "/icons/skipIcon48.png",
    "128": "/icons/skipIcon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "run_at": "document_start",
      "js": ["content.js"]
    },
    {
      "matches": ["<all_urls>"],
      "js": ["mellowtel.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "optional_permissions": ["tabs", "declarativeNetRequestWithHostAccess"],
  "optional_host_permissions": ["https://*/*"],
  "permissions": ["storage"]
}
